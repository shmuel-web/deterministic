# Deterministic — local environment. Copy to `.env` (gitignored) for development.
# Everything here is OPTIONAL; with none set, the tool runs normally.

# ── Dev LLM/agent tracing (#90) ───────────────────────────────────────────────
# See what the agents are doing on your machine: every LLM call is traced to a
# self-hosted Langfuse (run it via dev/langfuse). DEV-ONLY — never shipped.
#
# FAIL-CLOSED: when this is on and Langfuse is unreachable, the process refuses to
# run un-traced. Leave it unset for normal / CI runs (zero footprint).
# DETERMINISTIC_DEV_TRACING=1
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# ── Model overrides (optional) ────────────────────────────────────────────────
# DETERMINISTIC_OLLAMA_MODEL=gemma4
# Model tiering (#86) — route cheap boolean calls to a small model.
# Needs OLLAMA_MAX_LOADED_MODELS>=2 so both models stay resident (else it thrashes).
# DETERMINISTIC_OLLAMA_MODEL_TINY=gemma3:1b
# DETERMINISTIC_OLLAMA_MODEL_DEEP=gemma4

# Concurrency for file scoring (default 4).
# DETERMINISTIC_CONCURRENCY=4
