{
  "name": "deterministic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A CLI linter that combines deterministic checks with focused LLM rules.",
  "bin": {
    "deterministic": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "deterministic": "tsx src/cli.ts",
    "score:repo": "tsx src/cli.ts score repo",
    "deterministic:baseline": "tsx src/cli.ts init",
    "bench:llm": "tsx tests/perf/run.mts",
    "test": "tsx --test tests/contract/*.test.ts tests/unit/*.test.ts tests/integration/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary npm test",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "c8": "^10.1.2",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0"
  }
}
